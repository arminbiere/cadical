+#include "cadical.hpp"
+#include <cassert>
+#include <vector>
+#include <iostream>
+
+using namespace CaDiCaL;
+
+// __HABITAT Test: Core API semantic change - ival() returns literal not sign
+void __HABITAT_test_ival_returns_literal_not_sign() {
+    Solver *solver = new Solver();
+
+    // Simple satisfiable formula: (1) (2) (-1 Γê¿ -2)
+    solver->add(1);
+    solver->add(2);
+    solver->add(0);
+    solver->add(-1);
+    solver->add(-2);
+    solver->add(0);
+
+    int res = solver->solve();
+    assert(res == 10); // SAT
+
+    // Critical test: ival should return the literal itself, not just sign
+    int val1 = solver->val(1);
+    int val2 = solver->val(2);
+    int val_neg1 = solver->val(-1);
+    int val_neg2 = solver->val(-2);
+
+    // The new semantics: val(lit) returns lit if true, -lit if false
+    assert(val1 == 1 || val1 == -1);
+    assert(val2 == 2 || val2 == -2);
+    assert(val_neg1 == 1 || val_neg1 == -1);
+    assert(val_neg2 == 2 || val_neg2 == -2);
+
+    // Consistency check: val(lit) and val(-lit) must be opposites
+    assert(val1 == -val_neg1);
+    assert(val2 == -val_neg2);
+
+    delete solver;
+}
+
+// __HABITAT Test: Edge case with unassigned variables
+void __HABITAT_test_unassigned_variables_return_zero() {
+    Solver *solver = new Solver();
+
+    // Add variables but don't constrain them
+    solver->add(1);
+    solver->add(2);
+    solver->add(0);
+
+    int res = solver->solve();
+    assert(res == 10); // SAT
+
+    // Unassigned variables should return 0
+    int val3 = solver->val(3);
+    int val_neg3 = solver->val(-3);
+    assert(val3 == 0);
+    assert(val_neg3 == 0);
+
+    delete solver;
+}
+
+// __HABITAT Test: Complex formula with multiple solutions
+void __HABITAT_test_complex_formula_consistency() {
+    Solver *solver = new Solver();
+
+    // (1 Γê¿ 2 Γê¿ 3) Γêº (-1 Γê¿ -2) Γêº (-2 Γê¿ -3) Γêº (-1 Γê¿ -3)
+    solver->add(1); solver->add(2); solver->add(3); solver->add(0);
+    solver->add(-1); solver->add(-2); solver->add(0);
+    solver->add(-2); solver->add(-3); solver->add(0);
+    solver->add(-1); solver->add(-3); solver->add(0);
+
+    int res = solver->solve();
+    assert(res == 10); // SAT
+
+    // Check consistency across all variables
+    std::vector<int> vals;
+    for (int i = 1; i <= 3; i++) {
+        int val_pos = solver->val(i);
+        int val_neg = solver->val(-i);
+
+        // Must return literal or its negation
+        assert(val_pos == i || val_pos == -i);
+        assert(val_neg == i || val_neg == -i);
+        // Must be opposites
+        assert(val_pos == -val_neg);
+
+        vals.push_back(val_pos);
+    }
+
+    // Check that at most one variable is true (due to constraints)
+    int true_count = 0;
+    for (int val : vals) {
+        if (val > 0) true_count++;
+    }
+    assert(true_count <= 1);
+
+    delete solver;
+}
+
+// __HABITAT Test: UNSAT formula behavior
+void __HABITAT_test_unsat_formula_values() {
+    Solver *solver = new Solver();
+
+    // Contradictory formula: (1) and (-1)
+    solver->add(1);
+    solver->add(0);
+    solver->add(-1);
+    solver->add(0);
+
+    int res = solver->solve();
+    assert(res == 20); // UNSAT
+
+    // In UNSAT case, val should return 0 for all literals
+    int val1 = solver->val(1);
+    int val_neg1 = solver->val(-1);
+    int val2 = solver->val(2);
+    int val_neg2 = solver->val(-2);
+
+    assert(val1 == 0);
+    assert(val_neg1 == 0);
+    assert(val2 == 0);
+    assert(val_neg2 == 0);
+
+    delete solver;
+}
+
+// __HABITAT Test: Incremental solving with assumptions
+void __HABITAT_test_incremental_assumptions() {
+    Solver *solver = new Solver();
+
+    // Formula: (1 Γê¿ 2) Γêº (-1 Γê¿ 3) Γêº (-2 Γê¿ -3)
+    solver->add(1); solver->add(2); solver->add(0);
+    solver->add(-1); solver->add(3); solver->add(0);
+    solver->add(-2); solver->add(-3); solver->add(0);
+
+    // Solve with assumption 1
+    std::vector<int> assumptions = {1};
+    int res = solver->solve(assumptions);
+    assert(res == 10); // SAT
+
+    // Check values under assumption
+    int val1 = solver->val(1);
+    int val2 = solver->val(2);
+    int val3 = solver->val(3);
+
+    assert(val1 == 1); // Assumption should be true
+    assert(val2 == 2 || val2 == -2);
+    assert(val3 == 3 || val3 == -3);
+
+    // Check consistency
+    assert(val1 == -solver->val(-1));
+    assert(val2 == -solver->val(-2));
+    assert(val3 == -solver->val(-3));
+
+    delete solver;
+}
+
+// __HABITAT Test: Variable bounds and edge cases
+void __HABITAT_test_variable_bounds_and_edge_cases() {
+    Solver *solver = new Solver();
+
+    // Test with variable 0 (should be invalid)
+    bool exception_caught = false;
+    try {
+        solver->val(0);
+    } catch (...) {
+        exception_caught = true;
+    }
+    // Note: The actual behavior depends on implementation
+
+    // Test with very large variable numbers
+    const int large_var = 10000;
+    solver->add(large_var);
+    solver->add(0);
+
+    int res = solver->solve();
+    assert(res == 10);
+
+    int val_large = solver->val(large_var);
+    int val_neg_large = solver->val(-large_var);
+
+    assert(val_large == large_var || val_large == -large_var);
+    assert(val_neg_large == large_var || val_neg_large == -large_var);
+    assert(val_large == -val_neg_large);
+
+    delete solver;
+}
+
+// __HABITAT Test: Model consistency after multiple solves
+void __HABITAT_test_multiple_solve_consistency() {
+    Solver *solver = new Solver();
+
+    // Simple formula
+    solver->add(1);
+    solver->add(2);
+    solver->add(0);
+
+    // First solve
+    int res1 = solver->solve();
+    assert(res1 == 10);
+
+    int val1_first = solver->val(1);
+    int val2_first = solver->val(2);
+
+    // Second solve (should be consistent)
+    int res2 = solver->solve();
+    assert(res2 == 10);
+
+    int val1_second = solver->val(1);
+    int val2_second = solver->val(2);
+
+    // Values should be consistent across solves
+    assert(val1_first == val1_second);
+    assert(val2_first == val2_second);
+
+    // Check consistency with negations
+    assert(val1_second == -solver->val(-1));
+    assert(val2_second == -solver->val(-2));
+
+    delete solver;
+}
+
+// __HABITAT Test: Stress test with many variables
+void __HABITAT_test_stress_many_variables() {
+    Solver *solver = new Solver();
+
+    const int num_vars = 1000;
+
+    // Add a simple constraint: at least one variable must be true
+    for (int i = 1; i <= num_vars; i++) {
+        solver->add(i);
+    }
+    solver->add(0);
+
+    int res = solver->solve();
+    assert(res == 10);
+
+    // Check all variables for consistency
+    int true_count = 0;
+    for (int i = 1; i <= num_vars; i++) {
+        int val_pos = solver->val(i);
+        int val_neg = solver->val(-i);
+
+        assert(val_pos == i || val_pos == -i);
+        assert(val_neg == i || val_neg == -i);
+        assert(val_pos == -val_neg);
+
+        if (val_pos > 0) true_count++;
+    }
+
+    // At least one should be true
+    assert(true_count >= 1);
+
+    delete solver;
+}
+
+// __HABITAT Test: Deeply nested formula with backtracking
+void __HABITAT_test_nested_formula_backtracking() {
+    Solver *solver = new Solver();
+
+    // Create a complex formula that requires backtracking
+    // This tests the solver's internal state consistency
+
+    // Add variables with complex constraints
+    for (int i = 1; i <= 10; i++) {
+        solver->add(i);
+        solver->add(0);
+    }
+
+    // Add constraints that create dependencies
+    for (int i = 1; i < 10; i++) {
+        solver->add(-i);
+        solver->add(i + 1);
+        solver->add(0);
+    }
+
+    int res = solver->solve();
+    assert(res == 10);
+
+    // Verify all variables are consistent
+    for (int i = 1; i <= 10; i++) {
+        int val_pos = solver->val(i);
+        int val_neg = solver->val(-i);
+
+        assert(val_pos == i || val_pos == -i);
+        assert(val_neg == i || val_neg == -i);
+        assert(val_pos == -val_neg);
+    }
+
+    // Due to constraints, there should be exactly one true variable
+    int true_count = 0;
+    for (int i = 1; i <= 10; i++) {
+        if (solver->val(i) > 0) true_count++;
+    }
+    assert(true_count == 1);
+
+    delete solver;
+}
+
+int main() {
+    std::cout << "Running HABITAT validation API tests..." << std::endl;
+
+    __HABITAT_test_ival_returns_literal_not_sign();
+    __HABITAT_test_unassigned_variables_return_zero();
+    __HABITAT_test_complex_formula_consistency();
+    __HABITAT_test_unsat_formula_values();
+    __HABITAT_test_incremental_assumptions();
+    __HABITAT_test_variable_bounds_and_edge_cases();
+    __HABITAT_test_multiple_solve_consistency();
+    __HABITAT_test_stress_many_variables();
+    __HABITAT_test_nested_formula_backtracking();
+
+    std::cout << "All HABITAT validation API tests passed!" << std::endl;
+    return 0;
+}
