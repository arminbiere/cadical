+// __HABITAT Test: Critical edge case - INT_MIN literal handling
+void __HABITAT_test_int_min_literal_handling() {
+    Solver *solver = new Solver();
+
+    // Test with INT_MIN - this should not crash and should be handled gracefully
+    bool exception_caught = false;
+    try {
+        int val = solver->val(INT_MIN);
+        // Should either return 0 or handle gracefully
+        (void)val; // Suppress unused variable warning
+    } catch (...) {
+        exception_caught = true;
+    }
+
+    // The exact behavior depends on implementation, but it shouldn't crash
+    // This tests the assert(elit != INT_MIN) in the new implementation
+
+    delete solver;
+}
+
+// __HABITAT Test: Memory boundary conditions
+void __HABITAT_test_memory_boundary_conditions() {
+    Solver *solver = new Solver();
+
+    // Test with variables that might trigger boundary conditions
+    const int boundary_var = 32767; // Near signed 16-bit limit
+
+    solver->add(boundary_var);
+    solver->add(0);
+
+    int res = solver->solve();
+    assert(res == 10);
+
+    int val_boundary = solver->val(boundary_var);
+    int val_neg_boundary = solver->val(-boundary_var);
+
+    assert(val_boundary == boundary_var || val_boundary == -boundary_var);
+    assert(val_neg_boundary == boundary_var || val_neg_boundary == -boundary_var);
+    assert(val_boundary == -val_neg_boundary);
+
+    delete solver;
+}
+
+// __HABITAT Test: Solution consistency after constraint addition
+void __HABITAT_test_solution_consistency_after_constraints() {
+    Solver *solver = new Solver();
+
+    // Initial formula
+    solver->add(1);
+    solver->add(2);
+    solver->add(0);
+
+    int res1 = solver->solve();
+    assert(res1 == 10);
+
+    int val1_initial = solver->val(1);
+    int val2_initial = solver->val(2);
+
+    // Add more constraints
+    solver->add(-1);
+    solver->add(3);
+    solver->add(0);
+
+    int res2 = solver->solve();
+    assert(res2 == 10);
+
+    int val1_new = solver->val(1);
+    int val2_new = solver->val(2);
+    int val3_new = solver->val(3);
+
+    // All values should be consistent with new semantics
+    assert(val1_new == 1 || val1_new == -1);
+    assert(val2_new == 2 || val2_new == -2);
+    assert(val3_new == 3 || val3_new == -3);
+
+    // Check opposites
+    assert(val1_new == -solver->val(-1));
+    assert(val2_new == -solver->val(-2));
+    assert(val3_new == -solver->val(-3));
+
+    delete solver;
+}
+
+// __HABITAT Test: Complex assumption scenarios
+void __HABITAT_test_complex_assumption_scenarios() {
+    Solver *solver = new Solver();
+
+    // Formula: (1 Γê¿ 2 Γê¿ 3) Γêº (-1 Γê¿ -2) Γêº (-2 Γê¿ -3) Γêº (-1 Γê¿ -3)
+    solver->add(1); solver->add(2); solver->add(3); solver->add(0);
+    solver->add(-1); solver->add(-2); solver->add(0);
+    solver->add(-2); solver->add(-3); solver->add(0);
+    solver->add(-1); solver->add(-3); solver->add(0);
+
+    // Test with contradictory assumptions
+    std::vector<int> contradictory_assumptions = {1, -1};
+    int res_contradictory = solver->solve(contradictory_assumptions);
+    assert(res_contradictory == 20); // UNSAT
+
+    // In UNSAT, all values should be 0
+    assert(solver->val(1) == 0);
+    assert(solver->val(-1) == 0);
+    assert(solver->val(2) == 0);
+    assert(solver->val(-2) == 0);
+
+    // Test with consistent assumptions
+    std::vector<int> consistent_assumptions = {1};
+    int res_consistent = solver->solve(consistent_assumptions);
+    assert(res_consistent == 10); // SAT
+
+    int val1 = solver->val(1);
+    int val2 = solver->val(2);
+    int val3 = solver->val(3);
+
+    assert(val1 == 1); // Assumption should be true
+    assert(val2 == 2 || val2 == -2);
+    assert(val3 == 3 || val3 == -3);
+
+    delete solver;
+}
+
+// __HABITAT Test: Solver state consistency after failed solves
+void __HABITAT_test_solver_state_after_failed_solves() {
+    Solver *solver = new Solver();
+
+    // Create a formula that will fail
+    solver->add(1);
+    solver->add(0);
+    solver->add(-1);
+    solver->add(0);
+
+    int res_unsat = solver->solve();
+    assert(res_unsat == 20); // UNSAT
+
+    // All values should be 0 after UNSAT
+    assert(solver->val(1) == 0);
+    assert(solver->val(-1) == 0);
+    assert(solver->val(2) == 0);
+    assert(solver->val(-2) == 0);
+
+    // Now add a satisfiable formula
+    solver = new Solver(); // Fresh solver
+    solver->add(2);
+    solver->add(0);
+
+    int res_sat = solver->solve();
+    assert(res_sat == 10); // SAT
+
+    int val2 = solver->val(2);
+    assert(val2 == 2 || val2 == -2);
+    assert(val2 == -solver->val(-2));
+
+    delete solver;
+}
+
+// __HABITAT Test: Performance with large clause sets
+void __HABITAT_test_performance_large_clause_sets() {
+    Solver *solver = new Solver();
+
+    const int num_vars = 100;
+    const int num_clauses = 500;
+
+    // Generate random-like clauses
+    for (int i = 0; i < num_clauses; i++) {
+        for (int j = 1; j <= 3; j++) {
+            int var = (i * 3 + j) % num_vars + 1;
+            int lit = (i % 2 == 0) ? var : -var;
+            solver->add(lit);
+        }
+        solver->add(0);
+    }
+
+    int res = solver->solve();
+    assert(res == 10 || res == 20); // Either SAT or UNSAT is fine
+
+    if (res == 10) {
+        // If SAT, check consistency
+        for (int i = 1; i <= num_vars; i++) {
+            int val_pos = solver->val(i);
+            int val_neg = solver->val(-i);
+
+            assert(val_pos == i || val_pos == -i || val_pos == 0);
+            assert(val_neg == i || val_neg == -i || val_neg == 0);
+            assert(val_pos == -val_neg);
+        }
+    }
+
+    delete solver;
+}
+
+// __HABITAT Test: Edge case with variable initialization
+void __HABITAT_test_variable_initialization_edge_cases() {
+    Solver *solver = new Solver();
+
+    // Test accessing variables before any are added
+    int val_early = solver->val(1);
+    assert(val_early == 0); // Should be 0 for unadded variables
+
+    // Add variables one by one and test
+    solver->add(1);
+    int res1 = solver->solve();
+    assert(res1 == 10);
+
+    int val1 = solver->val(1);
+    assert(val1 == 1 || val1 == -1);
+
+    // Add second variable
+    solver->add(2);
+    int res2 = solver->solve();
+    assert(res2 == 10);
+
+    int val1_again = solver->val(1);
+    int val2 = solver->val(2);
+
+    assert(val1_again == 1 || val1_again == -1);
+    assert(val2 == 2 || val2 == -2);
+
+    // Values should be consistent
+    assert(val1_again == -solver->val(-1));
+    assert(val2 == -solver->val(-2));
+
+    delete solver;
+}
+
+// __HABITAT Test: Deep recursion and stack handling
+void __HABITAT_test_deep_recursion_handling() {
+    Solver *solver = new Solver();
+
+    // Create a formula that might cause deep recursion
+    const int depth = 50;
+
+    // Create a chain: (1) ΓåÆ (2) ΓåÆ (3) ΓåÆ ... ΓåÆ (depth)
+    for (int i = 1; i < depth; i++) {
+        solver->add(-i);
+        solver->add(i + 1);
+        solver->add(0);
+    }
+
+    // Add the first variable
+    solver->add(1);
+    solver->add(0);
+
+    int res = solver->solve();
+    assert(res == 10);
+
+    // All variables should be consistently assigned
+    for (int i = 1; i <= depth; i++) {
+        int val_pos = solver->val(i);
+        int val_neg = solver->val(-i);
+
+        assert(val_pos == i || val_pos == -i);
+        assert(val_neg == i || val_neg == -i);
+        assert(val_pos == -val_neg);
+    }
+
+    // Due to the chain structure, all should be true
+    for (int i = 1; i <= depth; i++) {
+        assert(solver->val(i) > 0);
+    }
+
+    delete solver;
+}
+
+// __HABITAT Test: Memory corruption detection
+void __HABITAT_test_memory_corruption_detection() {
+    Solver *solver = new Solver();
+
+    // Create multiple solvers to test for memory corruption
+    std::vector<Solver*> solvers;
+    for (int i = 0; i < 10; i++) {
+        solvers.push_back(new Solver());
+        solvers[i]->add(i + 1);
+        solvers[i]->add(0);
+    }
+
+    // Solve all
+    for (int i = 0; i < 10; i++) {
+        int res = solvers[i]->solve();
+        assert(res == 10);
+
+        int val = solvers[i]->val(i + 1);
+        assert(val == i + 1 || val == -(i + 1));
+        assert(val == -solvers[i]->val(-(i + 1)));
+    }
+
+    // Clean up
+    for (int i = 0; i < 10; i++) {
+        delete solvers[i];
+    }
+}
+
+// __HABITAT Test: Extreme variable numbers
+void __HABITAT_test_extreme_variable_numbers() {
+    Solver *solver = new Solver();
+
+    // Test with very large variable numbers
+    const int extreme_var = 1000000;
+
+    solver->add(extreme_var);
+    solver->add(0);
+
+    int res = solver->solve();
+    assert(res == 10);
+
+    int val_extreme = solver->val(extreme_var);
+    int val_neg_extreme = solver->val(-extreme_var);
+
+    assert(val_extreme == extreme_var || val_extreme == -extreme_var);
+    assert(val_neg_extreme == extreme_var || val_neg_extreme == -extreme_var);
+    assert(val_extreme == -val_neg_extreme);
+
+    delete solver;
+}
+
+int main() {
+    std::cout << "Running HABITAT validation edge case tests..." << std::endl;
+
+    __HABITAT_test_int_min_literal_handling();
+    __HABITAT_test_memory_boundary_conditions();
+    __HABITAT_test_solution_consistency_after_constraints();
+    __HABITAT_test_complex_assumption_scenarios();
+    __HABITAT_test_solver_state_after_failed_solves();
+    __HABITAT_test_performance_large_clause_sets();
+    __HABITAT_test_variable_initialization_edge_cases();
+    __HABITAT_test_deep_recursion_handling();
+    __HABITAT_test_memory_corruption_detection();
+    __HABITAT_test_extreme_variable_numbers();
+
+    std::cout << "All HABITAT validation edge case tests passed!" << std::endl;
+    return 0;
+}
