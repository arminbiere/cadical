+// __HABITAT Test: Complex formula with learned clauses
+void __HABITAT_test_learned_clause_consistency() {
+    Solver *solver = new Solver();
+
+    // Create a formula that will generate learned clauses
+    // This tests the solution checking on learned clauses
+
+    // Pigeonhole principle: 3 pigeons, 2 holes
+    for (int p = 1; p <= 3; p++) {
+        for (int h = 1; h <= 2; h++) {
+            solver->add(p * 10 + h); // Variable p*h means pigeon p in hole h
+        }
+        solver->add(0);
+    }
+
+    // Each pigeon in exactly one hole
+    for (int p = 1; p <= 3; p++) {
+        for (int h1 = 1; h1 <= 2; h1++) {
+            for (int h2 = h1 + 1; h2 <= 2; h2++) {
+                solver->add(-(p * 10 + h1));
+                solver->add(-(p * 10 + h2));
+                solver->add(0);
+            }
+        }
+    }
+
+    // Each hole has at most one pigeon
+    for (int h = 1; h <= 2; h++) {
+        for (int p1 = 1; p1 <= 3; p1++) {
+            for (int p2 = p1 + 1; p2 <= 3; p2++) {
+                solver->add(-(p1 * 10 + h));
+                solver->add(-(p2 * 10 + h));
+                solver->add(0);
+            }
+        }
+    }
+
+    int res = solver->solve();
+    assert(res == 20); // Should be UNSAT
+
+    // In UNSAT case, all values should be 0
+    for (int p = 1; p <= 3; p++) {
+        for (int h = 1; h <= 2; h++) {
+            int var = p * 10 + h;
+            assert(solver->val(var) == 0);
+            assert(solver->val(-var) == 0);
+        }
+    }
+
+    delete solver;
+}
